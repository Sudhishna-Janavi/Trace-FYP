# --- never commit: holds bcrypt password hashes for real accounts
trace.db
*.db-journal

# --- environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.cache/
.DS_Store

# --- third-party source data.
# The Kaggle corpora this project trains on are not ours to redistribute, and
# they are large. dataset/demo/ IS committed: the deployed application seeds
# itself from those feeds.
dataset/US/
dataset/Indian/
dataset/processed/

# --- local environment
.env

# --- report and its tooling are not part of the code deliverable.
# The report is submitted to the supervisor and examiners directly; keeping
# its prose out of a public repository also avoids a submission being matched
# against itself by a similarity check.
report/
*.docx

# local dev convenience, machine-specific absolute paths
.claude/
